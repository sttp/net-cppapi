<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- SDK projects select native assets from runtimes through NuGet. These copies are only for legacy projects. -->
  <ItemGroup Condition=" '$(UsingMicrosoftNETSdk)' != 'true' AND ('$(PlatformTarget)' == 'x64' OR ('$(PlatformTarget)' != 'x86' AND '$(Prefer32Bit)' == 'false')) ">
    <Content Include="$(MSBuildThisFileDirectory)\..\runtimes\win-x64\native\sttp.net.lib.dll" Visible="false">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>sttp.net.lib.dll</Link>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)\..\runtimes\linux-x64\native\sttp.net.lib.so" Visible="false">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>sttp.net.lib.so</Link>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(UsingMicrosoftNETSdk)' != 'true' AND ('$(PlatformTarget)' == 'x86' OR ('$(PlatformTarget)' != 'x64' AND '$(Prefer32Bit)' == 'true')) ">
    <Content Include="$(MSBuildThisFileDirectory)\..\runtimes\win-x86\native\sttp.net.lib.dll" Visible="false">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>sttp.net.lib.dll</Link>
    </Content>
  </ItemGroup>

</Project>